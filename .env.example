# Dandi 환경 변수 예시.
# 이 파일을 .env.local로 복사해 값을 채우십시오. .env.local은 Git에 올라가지 않습니다(.gitignore의 .env*).
# 이 파일(.env.example)에는 실제 키를 절대 적지 마십시오.
#
# 비워 두면 프로토타입 대체물로 동작합니다(로컬 JSON 저장소, 데모 로그인).

# ---------------------------------------------------------------------------
# 운영 환경 (README "운영 환경 변수" 참고). 로컬 시연에는 필요 없습니다.
# ---------------------------------------------------------------------------
# HUB_ORIGIN=https://dandi.example.kr
# SITES_DOMAIN=dandi-sites.kr
# SITES_ORIGIN=https://dandi-sites.vercel.app
# TRUST_PROXY=1
# DANDI_OAUTH_SECRET=
# DANDI_DATA_DIR=

# ---------------------------------------------------------------------------
# v1.0 Supabase (PRD F-01 익명 인증, F-02 구글·카카오 로그인, F-15 RLS)
# Supabase 계정·프로젝트와 설정은 아직 정해지지 않았습니다(README "소셜 로그인").
# 계정이 정해진 뒤 그 프로젝트의 API 키 화면에서 값을 복사해 넣습니다.
# 키 체계: https://supabase.com/docs/guides/api/api-keys (HANDOVER 7-2)
# ---------------------------------------------------------------------------

# 프로젝트 주소. 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키(sb_publishable_...). 브라우저에 들어가도 되는 키이며, 실제 보호는 RLS가 맡습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키(sb_secret_...). 서버 전용. RLS를 우회하므로 NEXT_PUBLIC_을 붙이거나 브라우저 코드에서 쓰지 마십시오.
SUPABASE_SECRET_KEY=

# 저장 위치. supabase면 DB는 dandi_state 테이블, 파일은 Storage 버킷(supabase/migrations의 SQL을 먼저 실행).
# 비워 두면 Vercel에서 위 세 값이 모두 있을 때만 supabase, 로컬에서는 data/ 폴더를 씁니다.
# DANDI_STORAGE=supabase
# DANDI_STORAGE_BUCKET=dandi

# 구글·카카오 로그인 키(Client ID / Client Secret)는 여기에 넣지 않습니다.
# Supabase Auth가 로그인을 처리하는 구조라 Supabase 쪽 provider 설정에 넣게 됩니다(설정 주체·방식 미정).
